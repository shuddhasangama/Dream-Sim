                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JourneyStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or session revoked.",
