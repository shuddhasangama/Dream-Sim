data/
__pycache__/
*.pyc
.env.signzy.test
.env.signzy.production
.pytest_cache/

# One-off commit helpers written during the Segment A-E build. They do a
# job once and are not part of the application.
commit-*.cmd
commit-message*.txt

# Where the browser drops the zips and docs from a Claude session. Not
# source, and the zips are ~1.5MB each. Added 2026-09-09 after an
# extract would otherwise have reverted this line and swept a zip into
# the next `git add -A`.
Claude outputs/

# Local development only (see docs/LOCAL_SETUP.md). Real local passwords/keys live in
# .env.local; never commit it. Build outputs (APK/AAB) never belong in git anywhere.
.env.local
.venv/
*.apk
*.aab

# Apple/Android signing material never belongs in git (sec-apple). The files already
# committed under mobile/ stay tracked until the keys are revoked and replaced (manual).
*.p8
*.p12
*.mobileprovision

# hypothesis example database (local fuzzing cache)
.hypothesis/
