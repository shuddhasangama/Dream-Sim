# DhaShu Dream-Sim - LOCAL development settings (template).
# Copy to .env.local, add ".env.local" to .git/info/exclude (see docs/LOCAL_SETUP.md), replace every CHANGE_ME.
# dev-local.ps1 loads this file; the app itself reads no env file. Never commit .env.local.
# Never put production/staging values here. See docs/LOCAL_SETUP.md.

# PostgreSQL 16 on localhost:5433 (NOT the 5432 instance). Replace CHANGE_ME with YOUR local postgres password.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/dhashu_local
# Postgres-backed tests only: separate database on the same server (host must be 127.0.0.1).
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/dhashu_test

# Generate locally (never reuse a deployed value):
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
#   .venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_TOTP_ENCRYPTION_KEY=CHANGE_ME
ADMIN_PUBLIC_ORIGIN=http://127.0.0.1:5001
ADMIN_ALLOW_HTTP=1

# Simulation / local switches
DEMO_MODE=1
DHASHU_SIMULATED_CLOCK=true
DHASHU_RESTAURANT_MODE=simulation
DHASHU_IDENTITY_VERIFICATION_MODE=simulation

# Providers OFF (no live calls). Do not add Twilio, MSG91, Razorpay, OpenAI or Signzy production keys.
PAYMENTS_ENABLED=0
DHASHU_BILLING_MODE=disabled
VERIFICATION_DELIVERY=0
SIGNZY_ENV=preproduction
SIGNZY_PRODUCTION_ENABLED=0
DHASHU_GURU_AI_ENABLED=0
# AUTH_ENABLED intentionally unset -> /pool picker login, no OTP.

# Worker-only values (dev-local.ps1 applies these ONLY to the worker process).
# bgv_worker.py refuses to start without a valid BGV config; the web app never gets these,
# so it never queues checks and the worker idles with zero provider calls.
WORKER__DHASHU_BGV_APP_ENABLED=1
# Deliberate non-credential placeholder (keep as is).
WORKER__SIGNZY_TEST_API_KEY=local-dummy-not-a-credential
# Generate locally with the Fernet command above (a different key from ADMIN_TOTP_ENCRYPTION_KEY).
WORKER__SIGNZY_RECEIPT_ENCRYPTION_KEY=CHANGE_ME

# Local harness: lets the Android emulator sign in as a seeded user (local_harness.py).
# Works only with AUTH_ENABLED unset, no production markers, and requests from this laptop.
DHASHU_LOCAL_HARNESS=1
