<!-- DEBUG BUILDS ONLY (merged into debug variants; release never sees this file).
     Lets an emulator dev build (npm run build:emulator) reach the laptop's local
     backend over plain http. The config permits cleartext ONLY to 10.0.2.2,
     localhost and 127.0.0.1; every other host stays https-only, even in debug. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
