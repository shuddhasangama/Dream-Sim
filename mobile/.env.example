# DhaShu mobile build settings. No secrets belong here.
# Copy to .env.<mode>.local (git-ignored) only if you need to override a default.
#
# Modes (see README.md):
#   npm run dev             preview: in-browser mock data, no server, nothing to set
#   npm run dev:local       browser + local backend at http://127.0.0.1:5000 (Vite proxy), nothing to set
#   npm run build:emulator  Android emulator dev build; defaults to http://10.0.2.2:5000
#   npm run build           release; VITE_API_BASE_URL is REQUIRED (set in codemagic.yaml)
#
# Release: a public https origin only (no path). The build refuses http,
# localhost, 10.0.2.2 and private addresses.
# VITE_API_BASE_URL=https://api.example.com
#
# Emulator/dev native builds: only 10.0.2.2, localhost or 127.0.0.1 are accepted.
# VITE_API_BASE_URL=http://10.0.2.2:5000
#
# Optional build-time convenience switch (the server still gates the clock).
# DHASHU_SIMULATED_CLOCK=false
