{
  "name": "dhashu-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "vite --host 127.0.0.1 --mode localbackend",
    "build": "vite build",
    "build:emulator": "vite build --mode emulator",
    "test": "node --test tests/*.test.js",
    "sync": "npm run build && cap sync android",
    "sync:emulator": "npm run build:emulator && cap sync android",
    "android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.0.2",
    "@capacitor/core": "8.4.3",
    "@capacitor/ios": "^8.4.3",
    "@sentry/browser": "11.17.0",
    "session-vault": "file:./plugins/session-vault"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "1.63.0",
    "vite": "8.3.8"
  }
}
